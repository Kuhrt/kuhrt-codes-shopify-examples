{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build", "build"] },
    "test": { "dependsOn": ["^build", "build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
