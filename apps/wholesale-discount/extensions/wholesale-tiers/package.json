{
  "name": "wholesale-tiers",
  "private": true,
  "type": "module",
  "scripts": {
    "shopify": "shopify",
    "typegen": "shopify app function typegen",
    "build": "shopify app function build",
    "preview": "shopify app function run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "codegen": {
    "schema": "schema.graphql",
    "documents": "src/*.graphql",
    "generates": {
      "./generated/api.ts": {
        "plugins": [
          "typescript",
          "typescript-operations"
        ]
      }
    },
    "config": {
      "omitOperationSuffix": true
    }
  },
  "dependencies": {
    "@shopify/shopify_function": "^2.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.6",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@repo/config": "workspace:*",
    "@shopify/cli": "4.9.3",
    "@shopify/shopify-function-test-helpers": "^1.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "graphql": "^16.11.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
