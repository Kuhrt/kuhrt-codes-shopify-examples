{%- comment -%}
  Outputs `value` when it is a #rgb or #rrggbb color, and nothing otherwise.
{%- endcomment -%}
{%- liquid
  assign color = value | append: '' | strip
  assign color_lead = color | slice: 0
  assign color_size = color | size
  if color_lead == '#'
    if color_size == 4 or color_size == 7
      echo color
    endif
  endif
-%}
