{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/reorder-point/shared/**",
        "!$TURBO_ROOT$/apps/reorder-point/shared/**/*.test.ts",
        "$TURBO_ROOT$/apps/reorder-point/eslint.ui-extension.mjs"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/reorder-point/shared/**",
        "!$TURBO_ROOT$/apps/reorder-point/shared/**/*.test.ts",
        "$TURBO_ROOT$/apps/reorder-point/tsconfig.ui-extension.json",
        "$TURBO_ROOT$/apps/reorder-point/vitest.ui-extension.ts"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/reorder-point/shared/**",
        "!$TURBO_ROOT$/apps/reorder-point/shared/**/*.test.ts",
        "$TURBO_ROOT$/apps/reorder-point/vitest.ui-extension.ts"
      ]
    }
  }
}
